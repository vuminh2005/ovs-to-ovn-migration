index 0000000..df9e720
--- /dev/null
+++ b/scripts/ns_icmp_logging.py
@@ -0,0 +1,98 @@
+"""Durable sender output and an explicitly checked Nova-console mirror.
+
+Ping output is secondary evidence of sequence/errors, not proof of wire sends.
+"""
+import fcntl
+import json
+import math
+from pathlib import Path
+
+PREFIX = 'OVN_NS_ICMP_JSON '
+
+
+def mirror_console(root, output, run):
+    rows = []
+    for line in output.splitlines():
+        if PREFIX not in line:
+            continue
+        try:
+            row = json.JSONDecoder().raw_decode(line.split(PREFIX, 1)[1])[0]
+            if row.get('run') == run and row.get('label') == 'snat':
+                rows.append(row)
+        except (TypeError, ValueError):
+            continue  # Missing event indices make the final mirror incomplete.
+    if not rows:
+        return
+    directory = Path(root)/'ns'
+    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
+    path = directory/'snat-icmp-sender.jsonl'
+    with path.open('a+') as stream:
+        fcntl.flock(stream, fcntl.LOCK_EX)
+        stream.seek(0)
+        seen = {line.strip() for line in stream if line.strip()}
+        stream.seek(0, 2)
+        for row in rows:
+            data = json.dumps(row, sort_keys=True)
+            if data not in seen:
+                if stream.tell()+len((data+'\n').encode()) > 67108864:
+                    raise ValueError('ICMP sender console mirror byte budget exhausted')
+                stream.write(data+'\n')
+                seen.add(data)
+        stream.flush()
+        path.chmod(0o600)
+
+
+def sender_evidence(path, run, direction, baseline, start, end):
+    result = dict(status='UNAVAILABLE', path=str(path),
+        scope='Source ping stdout/stderr; replies, outstanding probes and local errors; not wire-send timestamps')
+    try:
+        expected = baseline.get('icmp', {}).get('log_id')
+        if not expected:
+            raise ValueError('No baseline sender log identity')
+        rows = {}
+        raw = Path(path).read_bytes()
+        if len(raw) > 67108864:
+            raise ValueError('Sender log exceeds byte budget')
+        if raw and not raw.endswith(b'\n'):
+            raw = raw.rsplit(b'\n', 1)[0]+b'\n' if b'\n' in raw else b''
+            result['trailing_partial_line'] = True
+        for line in raw.decode().splitlines():
+            row = json.loads(line)
+            if row.get('run') != run or row.get('label') != direction or row.get('log_id') != expected:
+                raise ValueError('Sender run/label/log identity changed')
+            key = row['event_index']
+            if type(key) is not int or key < 1:
+                raise ValueError('Invalid sender event index')
+            if key in rows and rows[key] != row:
+                raise ValueError('Conflicting sender event index')
+            rows[key] = row
+        ordered = [rows[k] for k in sorted(rows)]
+        if not ordered or not start or not end:
+            raise ValueError('Missing sender log or PCAP time anchors')
+        if any(type(r.get(k)) not in (int, float) or not math.isfinite(r[k])
+               for r in ordered for k in ('observed_ts', 'observed_mono')):
+            raise ValueError('Invalid sender observation clocks')
+        if any(b['observed_mono'] <= a['observed_mono'] for a,b in zip(ordered, ordered[1:])):
+            raise ValueError('Sender monotonic clock moved backwards or duplicated')
+        if any(row.get('boot') != baseline.get('boot') or
+               row.get('ping_pid') != baseline.get('icmp', {}).get('pid') for row in ordered):
+            raise ValueError('Original sender boot/PID not preserved')
+        before = [r for r in ordered if r['observed_ts'] <= start]
+        after = [r for r in ordered if r['observed_ts'] >= end]
+        if not before or not after:
+            raise ValueError('Sender mirror does not cover PCAP measurement window')
+        selected = [r for r in ordered if before[-1]['event_index'] <= r['event_index'] <= after[0]['event_index']]
+        missing = sum(b['event_index']-a['event_index']-1 for a,b in zip(selected, selected[1:]))
+        result.update(event_count=len(selected), missing_event_count=missing,
+            start_event_index=selected[0]['event_index'], end_event_index=selected[-1]['event_index'],
+            errors=[r for r in selected if r['kind'] == 'error'][-20:],
+            outstanding_events=sum(r['kind']=='outstanding' for r in selected),
+            sequence_observations=[dict(icmp_sequence=r.get('icmp_sequence'), native_ts=r.get('native_ts'),
+                observed_ts=r['observed_ts'], kind=r['kind'], text=r.get('text', ''))
+                for r in selected if r.get('icmp_sequence') is not None])
+        if missing:
+            raise ValueError('Sender console mirror has missing event indices')
+        result['status'] = 'PASS'
+    except (OSError, ValueError, KeyError, TypeError) as exc:
+        result['reason'] = str(exc)
+    return result
diff --git a/scripts/ns_icmp_reconcile.py b/scripts/ns_icmp_reconcile.py
new file mode 100644
index 0000000..bfab8e5
--- /dev/null
+++ b/scripts/ns_icmp_reconcile.py
@@ -0,0 +1,79 @@
+"""Certify probe availability for exactly explained, internal local-error gaps.
+
+Never invent wire packets or source send timestamps. Missing attempts must be
+local Host Unreachable errors inside a burst already anchored by captured loss
+and recovery. Every unexplained gap, identity/capture failure stays unavailable.
+"""
+import copy
+import math
+import re
+
+
+ALLOWED = {'ICMP identifier/sequence discontinuity', 'Unexplained request cadence/capture gap'}
+
+
+def reconcile(value, rows, start, end, sender, observations, interval, source):
+    if value.get('status') == 'PASS' or not end or sender.get('status') != 'PASS':
+        return value
+    reasons = set(value.get('reason', '').split('; '))
+    if not reasons or reasons-ALLOWED:
+        return value
+    timed = rows[start['index']-1:end['index']]
+    if len(timed) < 2 or len({r['identifier'] for r in timed}) != 1:
+        return value
+    bursts = copy.deepcopy(value.get('failure_bursts', []))
+    if not bursts or any(b.get('duration_seconds') is None for b in bursts):
+        return value
+    missing = 0
+    explanations = []
+    for prior, current in zip(timed, timed[1:]):
+        delta = (current['icmp_sequence']-prior['icmp_sequence']) % 65536
+        elapsed = current['ts']-prior['ts']
+        if delta == 1 and 0 <= elapsed < 3*interval:
+            continue
+        if not (1 < delta < 32768 and elapsed > 0):
+            return value
+        # A local error cannot supply the missing attempt's send time. Only
+        # fill counts inside a loss burst with independently captured bounds.
+        burst = next((b for b in bursts if b['start_timestamp'] <= prior['ts'] and
+                      current['ts'] <= b['recovery_timestamp']), None)
+        if prior['reply_timestamp'] is not None or burst is None:
+            return value
+        candidates = [o for o in observations if prior['ts']-2 <= o['observed_ts'] <= current['ts']+2]
+        for offset in range(1, delta):
+            seq = (prior['icmp_sequence']+offset) % 65536
+            found = [o for o in candidates if o.get('icmp_sequence') == seq]
+            errors = [o for o in found if o.get('kind') == 'error']
+            if len(errors) != 1 or any(o.get('kind') == 'reply' for o in found):
+                return value
+            expected = r'^\[\d+\.\d+\] From '+re.escape(source)+r' icmp_seq='+str(seq)+r' Destination Host Unreachable$'
+            if not re.fullmatch(expected, errors[0].get('text', '')):
+                return value
+            stamp = errors[0].get('native_ts')
+            if type(stamp) not in (int, float) or not math.isfinite(stamp) or abs(stamp-errors[0]['observed_ts']) > 2:
+                return value
+        missing += delta-1
+        burst['failed_probes'] += delta-1
+        explanations.append(dict(previous_sequence=prior['icmp_sequence'], next_sequence=current['icmp_sequence'],
+            local_send_failures=delta-1, classification='source-host-unreachable',
+            gap_start_timestamp=prior['ts'], gap_end_timestamp=current['ts']))
+    if not missing:
+        return value
+    wire = copy.deepcopy(value)
+    attempts = value['packets_attempted']+missing
+    failures = value['packets_failed']+missing
+    longest = max(bursts, key=lambda b:b['duration_seconds'])
+    result = dict(value, status='PASS', metric_schema_version=2,
+        measurement_kind='icmp-probe-availability', coverage_complete=True,
+        coverage_scope='All probe attempts classified; raw PCAP wire coverage remains separate',
+        measurement_basis='sender-pcap-and-verified-local-errors', wire_capture_metrics=wire,
+        local_send_failures=missing, probe_attempts=attempts, probe_failures=failures,
+        probe_failure_percent=100*failures/attempts, reconciled_gaps=explanations,
+        failure_bursts=bursts, failure_burst_count=len(bursts),
+        maximum_consecutive_failed_probes=max(b['failed_probes'] for b in bursts),
+        actual_dataplane_outage_seconds=longest['duration_seconds'],
+        longest_outage_start_timestamp=longest['start_timestamp'],
+        longest_outage_recovery_timestamp=longest['recovery_timestamp'],
+        total_downtime_seconds=sum(b['duration_seconds'] for b in bursts))
+    result.pop('reason', None)
+    return result
