@@ -0,0 +1,85 @@
+#!/usr/bin/env python3
+"""N-S ICMP metrics from sender-side PCAP, avoiding translated ICMP identifiers."""
+import json
+from pathlib import Path
+
+from dataplane_capture import echo_rows, pcap_metrics, recovered_endpoint, save
+from ns_icmp_logging import sender_evidence
+
+
+def finalize(root):
+    root = Path(root)
+    cfg = json.loads((root/'validation-config.json').read_text())
+    ns = cfg.get('ns', {})
+    if not ns.get('enabled') or not ns.get('icmp_enabled'):
+        return {}
+    path = root/'ns-results.json'
+    result = json.loads(path.read_text()) if path.exists() else dict(status='UNAVAILABLE', directions={})
+    baseline = json.loads((root/'ns-baseline.json').read_text())
+    captures = json.loads((root/'ns-diagnostics.json').read_text()).get('captures', {})
+    outcomes = {}
+    for direction, kind, source, peer in (
+        ('snat', 'guest-snat', ns['outbound_ip'], ns['endpoint_ip']),
+        ('fip', 'endpoint', ns['endpoint_ip'], ns['fip_ip']),
+    ):
+        value = dict(status='UNAVAILABLE', reason='No valid ICMP PCAP window')
+        try:
+            cp = captures[kind]
+            if (cp.get('remote', {}).get('status') != 'STOPPED' or
+                    cp['remote'].get('dropped_packets') != 0):
+                raise ValueError('Capture completeness/drop count not proven')
+            raw = root/'ns-diagnostics'/kind/'tcp.pcap'
+            rows, problems = echo_rows(raw, source, peer)
+            start_ts = baseline['clients'][direction]['ts']
+            before = [r for r in rows if r['ts'] <= start_ts and r['reply_timestamp'] is not None]
+            if not before:
+                raise ValueError('No successful PCAP anchor before N-S baseline')
+            row = before[-1]
+            start = dict(index=row['index'], timestamp=row['ts'], reply_timestamp=row['reply_timestamp'],
+                         identifier=row['identifier'], icmp_sequence=row['icmp_sequence'])
+            end = recovered_endpoint(rows, cfg['interval'])
+            value = pcap_metrics(raw, dict(source_ip=source, peer_ip=peer,
+                remote=dict(cp['remote'], supervisor_gap=cp['remote'].get('supervisor_gap', False))),
+                                 dict(pcap_start=start, pcap_end=end), cfg['interval'])
+            value.update(measurement_workload='N-S '+direction.upper(), measurement_guest=kind,
+                evidence_source='sender-side-pcap', start_timestamp=start['timestamp'],
+                end_timestamp=end['timestamp'] if end else None,
+                scope='Successful sender-PCAP baseline anchor to final recovered sender-PCAP anchor; 56-byte ICMP')
+            bursts = value.get('failure_bursts', [])
+            value['total_downtime_seconds'] = (sum(b['duration_seconds'] for b in bursts)
+                if value['status'] == 'PASS' else None)
+            sender = sender_evidence(root/'ns'/(direction+'-icmp-sender.jsonl'), cfg.get('run'), direction,
+                baseline['clients'][direction], start['timestamp'], end['reply_timestamp'] if end else None)
+            observations = sender.pop('sequence_observations', [])
+            discontinuities = []
+            for prior, current in zip(rows, rows[1:]):
+                if current['ts'] < start['timestamp'] or (end and current['ts'] > end['timestamp']):
+                    continue
+                delta = (current['icmp_sequence']-prior['icmp_sequence']) % 65536
+                if current['identifier'] == prior['identifier'] and delta == 1:
+                    continue
+                same_identifier = current['identifier'] == prior['identifier']
+                gap = dict(previous_request=prior, next_request=current,
+                    kind='sequence_gap_or_reset' if same_identifier else 'identifier_change',
+                    missing_request_count=delta-1 if same_identifier and 1 < delta < 32768 else None,
+                    sender_observations=[r for r in observations if same_identifier and 1 < delta < 32768 and
+                        prior['ts']-2 <= r['observed_ts'] <= current['ts']+2 and
+                        0 < (r['icmp_sequence']-prior['icmp_sequence']) % 65536 < delta])
+                discontinuities.append(gap)
+            value.update(sender_log=sender, request_discontinuities=discontinuities)
+            if value['status'] != 'PASS' and bursts:
+                value['observed_window'] = dict(certified=False,
+                    scope='Captured requests/replies only; missing sender requests remain unaccounted',
+                    first_failure_timestamp=value['first_failure_timestamp'], recovery_timestamp=value['recovery_timestamp'],
+                    failure_bursts=bursts)
+        except (OSError, ValueError, KeyError, TypeError, IndexError) as exc:
+            value.update(status='UNAVAILABLE', reason=str(exc))
+        outcomes[direction] = value
+        entry = result.setdefault('directions', {}).setdefault(direction, {})
+        entry['icmp'] = value
+        if value['status'] != 'PASS':
+            entry['status'] = 'FAIL'
+            result['status'] = 'FAIL'
+    save(root/'ns-icmp-results.json', outcomes)
+    save(path, result)
+    return outcomes
diff --git a/scripts/ns_icmp_logging.py b/scripts/ns_icmp_logging.py
new file mode 100644
index 0000000..49f14b5
--- /dev/null
+++ b/scripts/ns_icmp_logging.py
@@ -0,0 +1,91 @@
+"""Durable sender output and an explicitly checked Nova-console mirror.
+
+Ping output is secondary evidence of sequence/errors, not proof of wire sends.
+"""
+import fcntl
+import json
+import math
+from pathlib import Path
+
+PREFIX = 'OVN_NS_ICMP_JSON '
+
+
+def mirror_console(root, output, run):
+    rows = []
+    for line in output.splitlines():
+        if PREFIX not in line:
+            continue
+        try:
+            row = json.JSONDecoder().raw_decode(line.split(PREFIX, 1)[1])[0]
+            if row.get('run') == run and row.get('label') == 'snat':
+                rows.append(row)
+        except (TypeError, ValueError):
+            continue  # Missing event indices make the final mirror incomplete.
+    if not rows:
+        return
+    directory = Path(root)/'ns'
+    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
+    path = directory/'snat-icmp-sender.jsonl'
+    with path.open('a+') as stream:
+        fcntl.flock(stream, fcntl.LOCK_EX)
+        stream.seek(0)
+        seen = {line.strip() for line in stream if line.strip()}
+        stream.seek(0, 2)
+        for row in rows:
+            data = json.dumps(row, sort_keys=True)
+            if data not in seen:
+                if stream.tell()+len((data+'\n').encode()) > 67108864:
+                    raise ValueError('ICMP sender console mirror byte budget exhausted')
+                stream.write(data+'\n')
+                seen.add(data)
+        stream.flush()
+        path.chmod(0o600)
+
+
+def sender_evidence(path, run, direction, baseline, start, end):
+    result = dict(status='UNAVAILABLE', path=str(path),
+        scope='Source ping stdout/stderr; replies, outstanding probes and local errors; not wire-send timestamps')
+    try:
+        expected = baseline.get('icmp', {}).get('log_id')
+        if not expected:
+            raise ValueError('No baseline sender log identity')
+        rows = {}
+        for line in Path(path).read_text().splitlines():
+            row = json.loads(line)
+            if row.get('run') != run or row.get('label') != direction or row.get('log_id') != expected:
+                raise ValueError('Sender run/label/log identity changed')
+            key = row['event_index']
+            if type(key) is not int or key < 1:
+                raise ValueError('Invalid sender event index')
+            if key in rows and rows[key] != row:
+                raise ValueError('Conflicting sender event index')
+            rows[key] = row
+        ordered = [rows[k] for k in sorted(rows)]
+        if not ordered or not start or not end:
+            raise ValueError('Missing sender log or PCAP time anchors')
+        if any(type(r.get(k)) not in (int, float) or not math.isfinite(r[k])
+               for r in ordered for k in ('observed_ts', 'observed_mono')):
+            raise ValueError('Invalid sender observation clocks')
+        if any(b['observed_mono'] <= a['observed_mono'] for a,b in zip(ordered, ordered[1:])):
+            raise ValueError('Sender monotonic clock moved backwards or duplicated')
+        if any(row.get('boot') != baseline.get('boot') or
+               row.get('ping_pid') != baseline.get('icmp', {}).get('pid') for row in ordered):
+            raise ValueError('Original sender boot/PID not preserved')
+        before = [r for r in ordered if r['observed_ts'] <= start]
+        after = [r for r in ordered if r['observed_ts'] >= end]
+        if not before or not after:
+            raise ValueError('Sender mirror does not cover PCAP measurement window')
+        selected = [r for r in ordered if before[-1]['event_index'] <= r['event_index'] <= after[0]['event_index']]
+        missing = sum(b['event_index']-a['event_index']-1 for a,b in zip(selected, selected[1:]))
+        result.update(event_count=len(selected), missing_event_count=missing,
+            start_event_index=selected[0]['event_index'], end_event_index=selected[-1]['event_index'],
+            errors=[r for r in selected if r['kind'] == 'error'][-20:],
+            outstanding_events=sum(r['kind']=='outstanding' for r in selected),
